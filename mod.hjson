#the mod name as displayed in-game
displayName: "Beam Up"

#the internal name of your mod
name: "beam-up"

#your name
author: "TommyWhale28"

#the fully qualified main class of the mod
main: "beamup.BeamUp"

#the mod description as seen in the mod dialog
description: "A Mindustry mod that adds towers to transport items using laser links. Desktop Only Java Mod. For 160.5"

#the mod version
version: 1.0.0

#the minimum game build required to run this mod
minGameVersion: 160.5

#this is a java mod
java: true
